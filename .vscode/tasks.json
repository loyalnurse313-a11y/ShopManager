{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/ShopManager.Desktop/ShopManager.Desktop.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "publish-release",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/ShopManager.Desktop/ShopManager.Desktop.csproj",
        "-c", "Release",
        "-r", "win-x64",
        "--self-contained", "true"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
