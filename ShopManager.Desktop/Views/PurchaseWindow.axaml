<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ShopManager.Desktop.Views.PurchaseWindow"
        Title="ثبت خرید"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="False"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn,IRANSans,Segoe UI"
        Background="#F1F5F9">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- هدر -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24,16">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource IconCartPlus}" Width="20" Height="20"
                          Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="ثبت خرید از تأمین‌کننده"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- محتوای فرم -->
        <ScrollViewer Grid.Row="1">
            <Border Background="{DynamicResource AppCardBackground}" Margin="20" Padding="28" CornerRadius="6">
                <StackPanel Spacing="18">

                    <!-- تاریخ -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                            <TextBlock Text="تاریخ (شمسی)" 
                                       FontSize="14" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Text="*" FontSize="14" FontWeight="Bold" Foreground="#EF4444"/>
                        </StackPanel>
                        <TextBox x:Name="DateTextBox" 
                                 Watermark="مثال: 1405/07/05"
                                 FontSize="15" Padding="14,12"/>
                    </StackPanel>

                    <!-- کد کالا + نام -->
                    <Grid ColumnDefinitions="240,16,*">
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                                <TextBlock Text="کد یا نام کالا" 
                                           FontSize="14" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBlock Text="*" FontSize="14" FontWeight="Bold" Foreground="#EF4444"/>
                            </StackPanel>
                            <AutoCompleteBox x:Name="ItemSearchBox"
                                             Watermark="کد یا نام کالا..."
                                             FontSize="15" Padding="14,12"
                                             FilterMode="Contains"
                                             MinimumPrefixLength="1"
                                             SelectionChanged="OnItemSelected"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="نام کالا (خودکار)" 
                                       FontSize="14" FontWeight="SemiBold" Foreground="#334155"
                                       Margin="0,0,0,8"/>
                            <Border Background="#F8FAFC" 
                                    CornerRadius="6" 
                                    Padding="14,10"
                                    MinHeight="40">
                                <TextBlock x:Name="ItemNameText" 
                                           Text="—"
                                           FontSize="15"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- تعداد + قیمت واحد -->
                    <Grid ColumnDefinitions="*,16,*">
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                                <TextBlock Text="تعداد خریداری‌شده" 
                                           FontSize="14" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBlock Text="*" FontSize="14" FontWeight="Bold" Foreground="#EF4444"/>
                            </StackPanel>
                            <TextBox x:Name="QtyTextBox" 
                                     Watermark="مثال: 100"
                                     FontSize="15" Padding="14,12"
                                     TextChanged="OnQtyChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                                <TextBlock Text="قیمت خرید واحد (تومان)" 
                                           FontSize="14" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBlock Text="*" FontSize="14" FontWeight="Bold" Foreground="#EF4444"/>
                            </StackPanel>
                            <TextBox x:Name="UnitCostTextBox" 
                                     Watermark="مثال: 1000"
                                     FontSize="15" Padding="14,12"
                                     TextChanged="OnQtyChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- جمع کل — کارت سفید با نوار کناری سبز -->
                    <Border Background="{DynamicResource AppCardBackground}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid ColumnDefinitions="3,*">
                            <Border Grid.Column="0" Background="{DynamicResource AppSuccess}" CornerRadius="0,6,6,0"/>
                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="18,14">
                                <TextBlock Grid.Column="0"
                                           Text="جمع کل خرید"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppSuccess}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="TotalCostText"
                                           Text="۰ تومان"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource AppSuccess}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- تأمین‌کننده -->
                    <StackPanel>
                        <TextBlock Text="تأمین‌کننده / توضیحات" 
                                   FontSize="14" FontWeight="SemiBold" Foreground="#334155"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="SupplierTextBox" 
                                 Watermark="مثال: حق‌گو — سفارش راه‌اندازی"
                                 FontSize="15" Padding="14,12"/>
                    </StackPanel>

                    <!-- وضعیت پرداخت -->
                    <StackPanel>
                        <TextBlock Text="وضعیت پرداخت" 
                                   FontSize="14" FontWeight="SemiBold" Foreground="#334155"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <RadioButton x:Name="CashRadio" 
                                         Content="نقدی"
                                         GroupName="Payment"
                                         IsChecked="True"
                                         Foreground="{DynamicResource AppTextPrimary}"
                                         FontSize="15"/>
                            <RadioButton x:Name="CreditRadio" 
                                         Content="نسیه"
                                         GroupName="Payment"
                                         Foreground="{DynamicResource AppTextPrimary}"
                                         FontSize="15"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- لیست خریدهای امروز -->
                    <StackPanel>
                        <TextBlock Text="خریدهای ثبت‌شده امروز" 
                                   FontSize="14" FontWeight="SemiBold" Foreground="#334155"
                                   Margin="0,10,0,8"/>
                        <Border Background="#F8FAFC" 
                                CornerRadius="6" 
                                Padding="10"
                                MinHeight="120"
                                MaxHeight="200">
                            <ScrollViewer>
                                <StackPanel x:Name="TodayPurchasesPanel" Spacing="6">
                                    <TextBlock Text="هنوز خریدی ثبت نشده"
                                               Foreground="#94A3B8"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               Margin="0,30,0,30"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- پایین: پیام + دکمه‌ها -->
        <Border Grid.Row="2" 
                Background="{DynamicResource AppCardBackground}" 
                Padding="24,18"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">

                <TextBlock Grid.Column="0"
                           x:Name="StatusText"
                           Text=""
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppDanger}"
                           TextWrapping="Wrap"/>

                <!-- دکمه سابقه خرید -->
                <Button Grid.Column="1"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="{DynamicResource AppTableHeader}"
                        Foreground="{DynamicResource AppTextPrimary}"
                        Padding="18,12"
                        Margin="0,0,10,0"
                        CornerRadius="6"
                        Click="OnHistoryClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconHistory}" Width="16" Height="16"
                                   Foreground="{DynamicResource AppTextPrimary}"/>
                        <TextBlock Text="سابقه خرید" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- دکمه بستن -->
                <Button Grid.Column="2"
                        Content="بستن"
                        FontSize="15"
                        Padding="28,12"
                        Margin="0,0,10,0"
                        Background="{DynamicResource AppBackground}"
                        Foreground="{DynamicResource AppTextPrimary}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Click="OnCancelClick"/>

                <!-- دکمه ثبت خرید -->
                <Button Grid.Column="3"
                        FontSize="15"
                        FontWeight="Bold"
                        Padding="28,12"
                        Background="{DynamicResource AppAccent}"
                        Foreground="White"
                        CornerRadius="6"
                        Click="OnSaveClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- آیکون تیک به‌صورت SVG مستقیم تا در حالت RTL آینه/برعکس نشود -->
                        <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                              Fill="White" Width="18" Height="18" Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="ثبت خرید" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

    </Grid>

</Window>