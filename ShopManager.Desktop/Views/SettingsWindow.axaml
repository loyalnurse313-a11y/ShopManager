<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ShopManager.Desktop.Views.SettingsWindow"
        Title="تنظیمات"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="False"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource AppBackground}">

    <Window.Styles>
        <Style Selector="Button.settingTab">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- هدر — پس‌زمینه تیره ثابت (#0F172A) طبق الگوی Solid Modern -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24,18">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource IconCog}" Width="22" Height="22"
                                 Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="تنظیمات" FontSize="20" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- تب‌ها — پس‌زمینه غیرفعال Transparent، تب فعال AppAccent -->
        <Border Grid.Row="1" Background="White" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1" Padding="20,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="TabStoreBtn" Classes="settingTab" Background="{DynamicResource AppAccent}" Foreground="White" Click="OnTabStoreClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconStore}" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="فروشگاه" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TabFinanceBtn" Classes="settingTab" Background="Transparent" Foreground="{DynamicResource AppTextSecondary}" Click="OnTabFinanceClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconCurrencyUsd}" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="مالی" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TabInvoiceBtn" Classes="settingTab" Background="Transparent" Foreground="{DynamicResource AppTextSecondary}" Click="OnTabInvoiceClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconReceipt}" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="فاکتور و چاپ" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TabBackupBtn" Classes="settingTab" Background="Transparent" Foreground="{DynamicResource AppTextSecondary}" Click="OnTabBackupClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconBackupRestore}" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="بکاپ" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TabAppearanceBtn" Classes="settingTab" Background="Transparent" Foreground="{DynamicResource AppTextSecondary}" Click="OnTabAppearanceClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconPalette}" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="ظاهر" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Panel Grid.Row="2">
            <!-- تب فروشگاه -->
            <ScrollViewer x:Name="StorePanel" IsVisible="True">
                <StackPanel Margin="24" Spacing="16">
                    <Border Background="{DynamicResource AppCardBackground}" CornerRadius="6" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="24">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconStore}" Width="18" Height="18" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="اطلاعات فروشگاه" Classes="sectionTitle" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="نام فروشگاه" Classes="fieldLabel" Foreground="{DynamicResource AppTextPrimary}"/>
                                <TextBox x:Name="StoreNameBox" PlaceholderText="مثال: فروشگاه" FontSize="14" Padding="12,10"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="شماره تماس" Classes="fieldLabel" Foreground="{DynamicResource AppTextPrimary}"/>
                                    <TextBox x:Name="StorePhoneBox" PlaceholderText="مثال: 044-34567890" FontSize="14" Padding="12,10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="آدرس (اختیاری)" Classes="fieldLabel" Foreground="{DynamicResource AppTextPrimary}"/>
                                    <TextBox x:Name="StoreAddressBox" PlaceholderText="مثال: آدرس فروشگاه" FontSize="14" Padding="12,10"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel>
                                <TextBlock Text="متن پایین فاکتور" Classes="fieldLabel" Foreground="{DynamicResource AppTextPrimary}"/>
                                <TextBox x:Name="FooterTextBox" PlaceholderText="مثال: از خرید شما سپاسگزاریم" FontSize="14" Padding="12,10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource AppCardBackground}" CornerRadius="6" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="24">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconImage}" Width="18" Height="18" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="لوگوی فروشگاه" Classes="sectionTitle" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,16,*">
                                <Border Grid.Column="0" Width="120" Height="120" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="6">
                                    <Image x:Name="LogoPreview" Stretch="Uniform" Margin="8"/>
                                </Border>
                                <StackPanel Grid.Column="2" Spacing="10" VerticalAlignment="Center">
                                    <Button FontSize="14" FontWeight="SemiBold" Background="{DynamicResource AppAccent}" Foreground="White" Padding="20,10" CornerRadius="6" HorizontalAlignment="Left" Click="OnPickLogoClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource IconFolderOpen}" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="انتخاب لوگو" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button FontSize="14" Background="{DynamicResource AppDanger}" Foreground="White" Padding="20,10" CornerRadius="6" HorizontalAlignment="Left" Click="OnRemoveLogoClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource IconDelete}" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="حذف لوگو" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="LogoPathText" Text="" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- تب مالی -->
            <ScrollViewer x:Name="FinancePanel" IsVisible="False">
                <StackPanel Margin="24" Spacing="16">
                    <Border Background="{DynamicResource AppCardBackground}" CornerRadius="6" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="24">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconCurrencyUsd}" Width="18" Height="18" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="تنظیمات مالی" Classes="sectionTitle" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="سرمایه اولیه صندوق (تومان)" Classes="fieldLabel" Foreground="{DynamicResource AppTextPrimary}"/>
                                <TextBox x:Name="InitialCapitalBox" PlaceholderText="مثال: 500000000" FontSize="14" Padding="12,10"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="درصد سود پیش‌فرض (%)" Classes="fieldLabel" Foreground="{DynamicResource AppTextPrimary}"/>
                                <TextBox x:Name="DefaultMarkupBox" PlaceholderText="مثال: 30" FontSize="14" Padding="12,10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource AppCardBackground}" CornerRadius="6" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="24">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconCreditCard}" Width="18" Height="18" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="پایانه‌های POS بانکی" Classes="sectionTitle" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox x:Name="POSTerminalsBox" AcceptsReturn="True" Height="150" FontSize="14" Padding="12,10" TextWrapping="Wrap" PlaceholderText="هر خط یه پایانه:&#x0a;بانک ملی - صندوق ۱&#x0a;پاسارگاد - صندوق ۲"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- تب فاکتور و چاپ -->
            <ScrollViewer x:Name="InvoicePanel" IsVisible="False">
                <StackPanel Margin="24" Spacing="16">
                    <Border Background="{DynamicResource AppCardBackground}" CornerRadius="6" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="24">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconReceipt}" Width="18" Height="18" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="اندازه کاغذ فاکتور" Classes="sectionTitle" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Spacing="10">
                                <RadioButton x:Name="PaperA4Radio" GroupName="PaperSize" IsChecked="True"><TextBlock Text="A4 — پرینتر معمولی" FontSize="14" Foreground="{DynamicResource AppTextPrimary}"/></RadioButton>
                                <RadioButton x:Name="PaperA5Radio" GroupName="PaperSize"><TextBlock Text="A5 — نصف A4" FontSize="14" Foreground="{DynamicResource AppTextPrimary}"/></RadioButton>
                                <RadioButton x:Name="Paper80mmRadio" GroupName="PaperSize">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconPrinter}" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="رسید حرارتی ۸۰mm" FontSize="14" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="Paper58mmRadio" GroupName="PaperSize">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconPrinter}" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="رسید حرارتی ۵۸mm" FontSize="14" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource AppCardBackground}" CornerRadius="6" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="24">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconFlash}" Width="18" Height="18" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="چاپ خودکار" Classes="sectionTitle" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoPrintCheckBox" Content="بعد از ثبت فروش، فاکتور خودکار چاپ بشه" FontSize="14"/>
                            <CheckBox x:Name="ShowLogoCheckBox" Content="نمایش لوگو در فاکتور" FontSize="14" IsChecked="True"/>
                            <Button FontSize="14" FontWeight="SemiBold" Background="{DynamicResource AppAccent}" Foreground="White" Padding="24,14" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnPreviewInvoiceClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconPrinter}" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="نمایش پیش‌نمایش فاکتور نمونه" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- تب بکاپ -->
            <ScrollViewer x:Name="BackupPanel" IsVisible="False">
                <StackPanel Margin="24" Spacing="16">
                    <Border Background="{DynamicResource AppCardBackground}" CornerRadius="6" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="24">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconBackupRestore}" Width="18" Height="18" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="بکاپ خودکار" Classes="sectionTitle" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox x:Name="BackupAutoCheckBox" Content="بکاپ خودکار فعال باشد" FontSize="14" IsChecked="True"/>
                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="فاصله زمانی (دقیقه)" Classes="fieldLabel" Foreground="{DynamicResource AppTextPrimary}"/>
                                    <ComboBox x:Name="BackupIntervalCombo" SelectedIndex="1" HorizontalAlignment="Stretch" FontSize="14" Padding="12,10">
                                        <ComboBoxItem>۵ دقیقه</ComboBoxItem><ComboBoxItem>۱۵ دقیقه</ComboBoxItem><ComboBoxItem>۳۰ دقیقه</ComboBoxItem><ComboBoxItem>۱ ساعت</ComboBoxItem><ComboBoxItem>۲ ساعت</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="تعداد بکاپ‌های نگهداری" Classes="fieldLabel" Foreground="{DynamicResource AppTextPrimary}"/>
                                    <ComboBox x:Name="BackupKeepCombo" SelectedIndex="2" HorizontalAlignment="Stretch" FontSize="14" Padding="12,10">
                                        <ComboBoxItem>۱۰ بکاپ</ComboBoxItem><ComboBoxItem>۲۰ بکاپ</ComboBoxItem><ComboBoxItem>۳۰ بکاپ</ComboBoxItem><ComboBoxItem>۵۰ بکاپ</ComboBoxItem><ComboBoxItem>۱۰۰ بکاپ</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource AppCardBackground}" CornerRadius="6" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="24">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconChartLine}" Width="18" Height="18" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="وضعیت" Classes="sectionTitle" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,16,*">
                                <!-- کارت آمار: پس‌زمینه سفید و متن رنگی (به‌جای پس‌زمینه رنگی) -->
                                <Border Grid.Column="0" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                                    <StackPanel Spacing="4"><TextBlock Text="اندازه دیتابیس" FontSize="12" Foreground="{DynamicResource AppTextSecondary}"/><TextBlock x:Name="DbSizeText" Text="—" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppSuccess}"/></StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                                    <StackPanel Spacing="4"><TextBlock Text="تعداد بکاپ‌ها" FontSize="12" Foreground="{DynamicResource AppTextSecondary}"/><TextBlock x:Name="BackupCountText" Text="۰" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppAccent}"/></StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="LastBackupText" Text="" FontSize="12" Foreground="{DynamicResource AppTextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource AppCardBackground}" CornerRadius="6" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="24">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconFlash}" Width="18" Height="18" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="عملیات سریع" Classes="sectionTitle" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,10,*">
                                <Button Grid.Column="0" FontSize="15" FontWeight="Bold" Background="{DynamicResource AppSuccess}" Foreground="White" Padding="20,14" CornerRadius="6" Click="OnManualBackupClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconContentSave}" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="گرفتن بکاپ الان" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" FontSize="15" FontWeight="SemiBold" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppTextPrimary}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="20,14" CornerRadius="6" Click="OnOpenBackupFolderClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconFolderOpen}" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="باز کردن پوشه بکاپ" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Button FontSize="15" FontWeight="SemiBold" Background="{DynamicResource AppWarning}" Foreground="White" Padding="20,14" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnShowBackupListClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconHistory}" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="مشاهده لیست بکاپ‌ها و بازیابی" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- تب ظاهر -->
            <ScrollViewer x:Name="AppearancePanel" IsVisible="False">
                <StackPanel Margin="24" Spacing="20">
                    <Border Background="{DynamicResource AppCardBackground}" CornerRadius="6" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="24">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconThemeLightDark}" Width="18" Height="18" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="تم برنامه" Classes="sectionTitle" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="30">
                                <RadioButton x:Name="ThemeLightRadio" GroupName="Theme" IsChecked="True">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconWeatherSunny}" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="روشن" FontSize="15" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ThemeDarkRadio" GroupName="Theme">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconWeatherNight}" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="تاریک" FontSize="15" Foreground="{DynamicResource AppTextPrimary}"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <!-- ═══ انتخاب صریح تم و رنگ اصلی — مبنای پیش‌نمایش زنده ═══ -->
                            <Grid ColumnDefinitions="*,20,*">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Text="حالت نمایش" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}"/>
                                    <!-- مقدار پایدار هر گزینه در Tag نگه داشته می‌شود تا منطق برنامه به متن فارسی وابسته نباشد -->
                                    <ComboBox x:Name="AppThemeComboBox" SelectedIndex="0" HorizontalAlignment="Stretch" Padding="14,12" FontSize="14">
                                        <ComboBoxItem Tag="Light">روشن</ComboBoxItem>
                                        <ComboBoxItem Tag="Dark">تاریک</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Text="رنگ اصلی" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}"/>
                                    <ComboBox x:Name="AppAccentComboBox" SelectedIndex="0" HorizontalAlignment="Stretch" Padding="14,12" FontSize="14">
                                        <ComboBoxItem Tag="Blue">آبی</ComboBoxItem>
                                        <ComboBoxItem Tag="Green">سبز</ComboBoxItem>
                                        <ComboBoxItem Tag="Red">قرمز</ComboBoxItem>
                                        <ComboBoxItem Tag="Orange">نارنجی</ComboBoxItem>
                                        <ComboBoxItem Tag="Purple">بنفش</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource AppCardBackground}" CornerRadius="6" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="24">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconFormatFont}" Width="18" Height="18" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="فونت و اندازه" Classes="sectionTitle" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,20,*">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Text="نوع فونت" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}"/>
                                    <ComboBox x:Name="FontComboBox" SelectedIndex="0" HorizontalAlignment="Stretch" Padding="14,12" FontSize="14">
                                        <ComboBoxItem>Vazirmatn</ComboBoxItem><ComboBoxItem>IRANSans</ComboBoxItem><ComboBoxItem>Tahoma</ComboBoxItem><ComboBoxItem>Segoe UI</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Text="اندازه فونت" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}"/>
                                    <ComboBox x:Name="FontSizeComboBox" SelectedIndex="1" HorizontalAlignment="Stretch" Padding="14,12" FontSize="14">
                                        <ComboBoxItem>کوچک (۱۲)</ComboBoxItem><ComboBoxItem>معمولی (۱۴)</ComboBoxItem><ComboBoxItem>بزرگ (۱۶)</ComboBoxItem><ComboBoxItem>خیلی بزرگ (۱۸)</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource AppCardBackground}" CornerRadius="6" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="24">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconPalette}" Width="18" Height="18" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="رنگ اصلی برنامه" Classes="sectionTitle" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- سواچ‌های رنگ — کاربردی، حفظ شد (به‌صورت داینامیک پر می‌شود) -->
                            <WrapPanel x:Name="PalettePanel" Orientation="Horizontal"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Panel>

        <Border Grid.Row="3" Background="{DynamicResource AppCardBackground}" Padding="20,16" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppSuccess}" TextWrapping="Wrap"/>
                <Button Grid.Column="1" FontSize="15" FontWeight="Bold" Background="{DynamicResource AppSuccess}" Foreground="White" Padding="30,12" Margin="0,0,10,0" CornerRadius="6" Click="OnSaveClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconContentSave}" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="ذخیره تنظیمات" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Content="بستن" FontSize="15" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppTextPrimary}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="30,12" CornerRadius="6" Click="OnCloseClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>
