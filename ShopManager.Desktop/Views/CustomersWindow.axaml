<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ShopManager.Desktop.ViewModels"
        mc:Ignorable="d"
        x:Class="ShopManager.Desktop.Views.CustomersWindow"
        Title="مشتری‌ها"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="False"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource AppBackground}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ═══════════ هدر ═══════════ -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24,16">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconAccountGroup}" Width="22" Height="22"
                          Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="لیست مشتری‌ها"
                           FontSize="18" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══════════ نوار جستجو ═══════════ -->
        <Border Grid.Row="1"
                Background="White"
                Padding="20,14"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                            Margin="0,0,10,0" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconMagnify}" Width="18" Height="18"
                              Foreground="{DynamicResource AppTextMuted}"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="جستجو:"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox Grid.Column="1"
                         x:Name="SearchBox"
                         Watermark="جستجو بر اساس نام یا شماره تماس..."
                         FontSize="14" Padding="14,10"
                         TextChanged="OnSearchChanged"/>
            </Grid>
        </Border>

        <!-- ═══════════ جدول مشتری‌ها ═══════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource AppCardBackground}"
                Margin="20"
                CornerRadius="6"
                BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">

                <!-- سرستون‌ها -->
                <Border Grid.Row="0" Background="#F1F5F9" Padding="15,14"
                        CornerRadius="6,6,0,0">
                    <Grid ColumnDefinitions="50,*,150,120,120,150">
                        <TextBlock Grid.Column="0" Text="#" FontWeight="Bold" FontSize="13"
                                   Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="نام مشتری" FontWeight="Bold" FontSize="13"
                                   Foreground="#0F172A"/>
                        <TextBlock Grid.Column="2" Text="شماره تماس" FontWeight="Bold" FontSize="13"
                                   Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="تعداد خرید" FontWeight="Bold" FontSize="13"
                                   Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="آخرین خرید" FontWeight="Bold" FontSize="13"
                                   Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="جمع خرید" FontWeight="Bold" FontSize="13"
                                   Foreground="#0F172A" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- سطرها -->
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="CustomersScrollViewer">
                        <ListBox x:Name="CustomersList" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:CustomerRow">
                                    <Border Padding="15,12" BorderBrush="#F1F5F9"
                                            BorderThickness="0,0,0,1" Background="White">
                                        <Grid ColumnDefinitions="50,*,150,120,120,150">
                                            <TextBlock Grid.Column="0" Text="{Binding RowNumber}"
                                                       Foreground="#475569"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       FontWeight="SemiBold" Foreground="#0F172A"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Phone}"
                                                       Foreground="{DynamicResource AppAccent}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PurchaseCount}"
                                                       FontWeight="Bold" Foreground="#0F172A"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding LastPurchaseDate}"
                                                       FontSize="12" Foreground="#475569"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding TotalAmount}"
                                                       FontWeight="Bold" Foreground="{DynamicResource AppSuccess}"
                                                       HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <!-- حالت خالی -->
                    <StackPanel x:Name="EmptyPanel"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="15">
                        <PathIcon Data="{StaticResource IconAccountGroup}" Width="60" Height="60"
                                  Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyTitle"
                                   Text="هنوز مشتری‌ای ثبت نشده"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Text="با ثبت اولین فروش با شماره تماس، مشتری‌ها اینجا ظاهر می‌شن"
                                   FontSize="13" Foreground="#94A3B8"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════ نوار پایین ═══════════ -->
        <Border Grid.Row="3"
                Background="{DynamicResource AppCardBackground}"
                Padding="20,14"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           x:Name="StatusText"
                           Text="آماده"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextMuted}"/>

                <Button Grid.Column="1"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="{DynamicResource AppSuccess}"
                        Foreground="White"
                        Padding="18,10"
                        Margin="0,0,10,0"
                        Click="OnExportExcelClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconFileExcel}" Width="16" Height="16"
                                  Foreground="White"/>
                        <TextBlock Text="خروجی اکسل" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        FontSize="14"
                        Background="{DynamicResource AppTableRow}"
                        Foreground="{DynamicResource AppTextPrimary}"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                        Padding="22,10"
                        Click="OnCloseClick">
                    <TextBlock Text="بستن"/>
                </Button>
            </Grid>
        </Border>

    </Grid>

</Window>
