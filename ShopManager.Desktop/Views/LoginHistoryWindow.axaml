<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ShopManager.Desktop.ViewModels"
        mc:Ignorable="d"
        x:Class="ShopManager.Desktop.Views.LoginHistoryWindow"
        Title="سابقه ورود کاربران"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="False"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource AppBackground}">

    <Window.Styles>
        <!-- الگوی «Solid Modern»: ردیف‌های جدول به‌صورت یک‌درمیان سفید و #FAFBFC -->
        <Style Selector="ListBox#HistoryList ListBoxItem:nth-child(even)">
            <Setter Property="Background" Value="#FAFBFC"/>
        </Style>
        <Style Selector="ListBox#HistoryList ListBoxItem:nth-child(odd)">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- هدر — پس‌زمینه تیره ثابت (#0F172A) طبق الگوی Solid Modern -->
        <Border Grid.Row="0" 
                Background="#0F172A" 
                Padding="24,18">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="{StaticResource IconHistory}" Width="22" Height="22"
                              Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="سابقه ورود و خروج کاربران"
                               FontSize="20" FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="2"
                           x:Name="TotalCountText"
                           Text=""
                           FontSize="14"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- فیلتر بازه تاریخ -->
        <Border Grid.Row="1" 
                Background="{DynamicResource AppCardBackground}" 
                Padding="20,16"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                        <PathIcon Data="{StaticResource IconClockOutline}" Width="14" Height="14"
                                  Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="از تاریخ" 
                                   FontSize="13" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource AppTextPrimary}"/>
                    </StackPanel>
                    <TextBox x:Name="FromDateBox" 
                             Width="140"
                             PlaceholderText="1405/01/01"
                             FontSize="14" Padding="12,10"/>
                </StackPanel>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                        <PathIcon Data="{StaticResource IconClockOutline}" Width="14" Height="14"
                                  Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="تا تاریخ" 
                                   FontSize="13" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource AppTextPrimary}"/>
                    </StackPanel>
                    <TextBox x:Name="ToDateBox" 
                             Width="140"
                             PlaceholderText="1405/12/29"
                             FontSize="14" Padding="12,10"/>
                </StackPanel>

                <!-- دکمه‌های بازه سریع — سبک ثانویه (کادر سیاه‌وسفید خنثی) -->
                <Button Content="امروز"
                        FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppTextPrimary}"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                        Padding="16,10" Margin="0,24,0,0"
                        CornerRadius="6"
                        Click="OnTodayClick"/>

                <Button Content="این هفته"
                        FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppTextPrimary}"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                        Padding="16,10" Margin="0,24,0,0"
                        CornerRadius="6"
                        Click="OnWeekClick"/>

                <Button Content="این ماه"
                        FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppTextPrimary}"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                        Padding="16,10" Margin="0,24,0,0"
                        CornerRadius="6"
                        Click="OnMonthClick"/>

                <!-- همه سوابق — رنگ Warning چون نمایش کل بازه (توجه‌برانگیز) -->
                <Button Content="همه سوابق"
                        FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource AppWarning}" Foreground="White"
                        Padding="16,10" Margin="0,24,0,0"
                        CornerRadius="6"
                        Click="OnAllClick"/>

                <Button FontSize="14" FontWeight="Bold"
                        Background="{DynamicResource AppAccent}" Foreground="White"
                        Padding="20,10" Margin="0,24,0,0"
                        CornerRadius="6"
                        Click="OnApplyFilterClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconFilter}" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="اعمال فیلتر" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- جستجو -->
        <Border Grid.Row="2" 
                Background="{DynamicResource AppCardBackground}" 
                Padding="20,12"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0"
                           Text="جستجو:"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimary}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBox Grid.Column="1"
                         x:Name="SearchBox"
                         PlaceholderText="نام کاربری یا نام کامل..."
                         FontSize="14" Padding="12,10"
                         TextChanged="OnSearchChanged"/>
            </Grid>
        </Border>

        <!-- جدول -->
        <Border Grid.Row="3" 
                Background="{DynamicResource AppCardBackground}" 
                Margin="20" 
                CornerRadius="6"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1">
            <Grid RowDefinitions="Auto,*">

                <!-- سرستون‌ها — هدر جدول #F1F5F9 -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource AppTableHeader}" 
                        Padding="15,14"
                        CornerRadius="6,6,0,0">
                    <Grid ColumnDefinitions="50,150,180,170,170,140,100,*">
                        <TextBlock Grid.Column="0" Text="#" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="نام کاربری" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="نام کامل" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="زمان ورود" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="زمان خروج" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="مدت حضور" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="وضعیت" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="توضیحات" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="HistoryScrollViewer">
                        <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:LoginHistoryRow">
                                    <Border Padding="15,12" 
                                            BorderBrush="{DynamicResource AppTableBorder}"
                                            BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="50,150,180,170,170,140,100,*">
                                            <TextBlock Grid.Column="0" Text="{Binding RowNumber}"
                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Username}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppAccent}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding FullName}"
                                                       Foreground="{DynamicResource AppTextPrimary}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding LoginAt}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AppTextPrimary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding LogoutAt}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AppTextPrimary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Duration}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AppAccent}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding Status}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AppTextPrimary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="7" Text="{Binding Note}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <StackPanel x:Name="EmptyPanel"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="15" IsVisible="False">
                        <PathIcon Data="{StaticResource IconHistory}" Width="60" Height="60"
                                  Foreground="{DynamicResource AppTextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyTitle"
                                   Text="سابقه‌ای در این بازه وجود ندارد"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- پایین -->
        <Border Grid.Row="4" 
                Background="{DynamicResource AppCardBackground}" 
                Padding="20,16"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="25">
                    <StackPanel>
                        <TextBlock Text="تعداد کل" FontSize="12" 
                                   Foreground="{DynamicResource AppTextSecondary}"/>
                        <TextBlock x:Name="TotalCountBottomText" Text="۰"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimary}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="ورود موفق" FontSize="12" 
                                   Foreground="{DynamicResource AppTextSecondary}"/>
                        <TextBlock x:Name="SuccessCountText" Text="۰"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AppSuccess}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="ورود ناموفق" FontSize="12" 
                                   Foreground="{DynamicResource AppTextSecondary}"/>
                        <TextBlock x:Name="FailedCountText" Text="۰"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AppDanger}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="جمع مدت حضور" FontSize="12" 
                                   Foreground="{DynamicResource AppTextSecondary}"/>
                        <TextBlock x:Name="TotalDurationText" Text="۰ دقیقه"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AppAccent}"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource AppSuccess}" Foreground="White"
                        Padding="18,10" Margin="0,0,10,0"
                        CornerRadius="6"
                        Click="OnExportExcelClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconFileExcel}" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="خروجی اکسل" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource AppAccent}" Foreground="White"
                        Padding="18,10" Margin="0,0,10,0"
                        CornerRadius="6"
                        Click="OnPrintClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconPrinter}" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="چاپ گزارش" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3"
                        FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource AppBackground}" 
                        Foreground="{DynamicResource AppTextPrimary}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1"
                        Padding="18,10" Margin="0,0,10,0"
                        CornerRadius="6"
                        Click="OnRefreshClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="بروزرسانی" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4"
                        FontSize="14"
                        Background="{DynamicResource AppBackground}"
                        Foreground="{DynamicResource AppTextPrimary}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1"
                        Padding="22,10"
                        CornerRadius="6"
                        Click="OnCloseClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconClose}" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="بستن" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

    </Grid>

</Window>
