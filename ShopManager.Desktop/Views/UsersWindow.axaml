<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ShopManager.Desktop.ViewModels"
        mc:Ignorable="d"
        x:Class="ShopManager.Desktop.Views.UsersWindow"
        Title="مدیریت کاربران"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="False"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource AppBackground}">

    <Window.Styles>
        <!-- الگوی «Solid Modern»: ردیف‌های جدول به‌صورت یک‌درمیان سفید و #FAFBFC -->
        <Style Selector="ListBox#UsersList ListBoxItem:nth-child(even)">
            <Setter Property="Background" Value="#FAFBFC"/>
        </Style>
        <Style Selector="ListBox#UsersList ListBoxItem:nth-child(odd)">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- هدر — پس‌زمینه تیره ثابت (#0F172A) طبق الگوی Solid Modern -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24,18">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="{StaticResource IconAccountMultiple}" Width="22" Height="22"
                              Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="مدیریت کاربران"
                               FontSize="20" FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="2"
                           x:Name="TotalCountText"
                           Text=""
                           FontSize="14"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- نوار ابزار + جستجو -->
        <Border Grid.Row="1" 
                Background="{DynamicResource AppCardBackground}" 
                Padding="20,14"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- دکمه‌ها -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            Spacing="10">
                    <Button FontSize="14" FontWeight="Bold"
                            Background="{DynamicResource AppAccent}"
                            Foreground="White"
                            Padding="20,10"
                            CornerRadius="6"
                            Click="OnAddUserClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconAccountPlus}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="افزودن کاربر" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button FontSize="14" FontWeight="SemiBold"
                            Background="{DynamicResource AppBackground}"
                            Foreground="{DynamicResource AppTextPrimary}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            Padding="18,10"
                            CornerRadius="6"
                            Click="OnRefreshClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="بروزرسانی" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- جستجو -->
                <Grid Grid.Column="2" 
                      ColumnDefinitions="Auto,220">
                    <TextBlock Grid.Column="0"
                               Text="جستجو:"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimary}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1"
                             x:Name="SearchBox"
                             PlaceholderText="نام کاربری یا نام کامل..."
                             FontSize="14" 
                             Padding="12,10"
                             TextChanged="OnSearchChanged"/>
                </Grid>

            </Grid>
        </Border>

        <!-- جدول -->
        <Border Grid.Row="2" 
                Background="{DynamicResource AppCardBackground}" 
                Margin="20" 
                CornerRadius="6"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1">
            <Grid RowDefinitions="Auto,*">

                <!-- سرستون‌ها — هدر جدول #F1F5F9 -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource AppTableHeader}" 
                        Padding="15,14"
                        CornerRadius="6,6,0,0">
                    <Grid ColumnDefinitions="50,150,*,120,100,150,180">
                        <TextBlock Grid.Column="0" Text="#" 
                                   FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="نام کاربری" 
                                   FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="نام کامل" 
                                   FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="نقش" 
                                   FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="وضعیت" 
                                   FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="آخرین ورود" 
                                   FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="عملیات" 
                                   FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ردیف‌ها -->
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="UsersScrollViewer">
                        <ListBox x:Name="UsersList" 
                                 BorderThickness="0" 
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:UserRow">
                                    <Border Padding="15,12" 
                                            BorderBrush="{DynamicResource AppTableBorder}"
                                            BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="50,150,*,120,100,150,180">
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding RowNumber}"
                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Username}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppAccent}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding FullName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextPrimary}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" 
                                                       Text="{Binding RoleDisplay}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AppTextPrimary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" 
                                                       Text="{Binding StatusDisplay}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AppTextPrimary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" 
                                                       Text="{Binding LastLoginDisplay}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            
                                            <!-- دکمه‌های عملیات — رنگ‌بندی معنایی: ویرایش=Accent، رمز=Warning، حذف=Danger -->
                                            <StackPanel Grid.Column="6"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Button FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Background="{DynamicResource AppAccent}"
                                                        Foreground="White"
                                                        Padding="12,6"
                                                        CornerRadius="6"
                                                        Tag="{Binding Id}"
                                                        Click="OnEditUserClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <PathIcon Data="{StaticResource IconPencil}" Width="14" Height="14" VerticalAlignment="Center"/>
                                                        <TextBlock Text="ویرایش" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                
                                                <Button FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Background="{DynamicResource AppWarning}"
                                                        Foreground="White"
                                                        Padding="12,6"
                                                        CornerRadius="6"
                                                        Tag="{Binding Id}"
                                                        Click="OnChangePasswordClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <PathIcon Data="{StaticResource IconKey}" Width="14" Height="14" VerticalAlignment="Center"/>
                                                        <TextBlock Text="رمز" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                
                                                <Button FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Background="{DynamicResource AppDanger}"
                                                        Foreground="White"
                                                        Padding="12,6"
                                                        CornerRadius="6"
                                                        Tag="{Binding Id}"
                                                        Click="OnDeleteUserClick">
                                                    <PathIcon Data="{StaticResource IconDelete}" Width="14" Height="14" VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyPanel"
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center"
                                Spacing="15"
                                IsVisible="False">
                        <PathIcon Data="{StaticResource IconAccountMultiple}" Width="60" Height="60"
                                  Foreground="{DynamicResource AppTextMuted}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyTitle"
                                   Text="هنوز کاربری ثبت نشده"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="برای شروع، روی دکمه «افزودن کاربر» کلیک کنید"
                                   FontSize="13" 
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- پایین -->
        <Border Grid.Row="3" 
                Background="{DynamicResource AppCardBackground}" 
                Padding="20,16"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           x:Name="StatusText"
                           Text=""
                           VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextSecondary}"/>

                <Button Grid.Column="1"
                        FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource AppAccent}" 
                        Foreground="White"
                        Padding="22,10"
                        Margin="0,0,10,0"
                        CornerRadius="6"
                        Click="OnLoginHistoryClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconHistory}" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="سابقه ورود" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Content="بستن"
                        FontSize="14"
                        Background="{DynamicResource AppBackground}"
                        Foreground="{DynamicResource AppTextPrimary}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1"
                        Padding="25,10"
                        CornerRadius="6"
                        Click="OnCloseClick"/>
            </Grid>
        </Border>

    </Grid>

</Window>
