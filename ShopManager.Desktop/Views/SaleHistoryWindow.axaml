<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ShopManager.Desktop.ViewModels"
        mc:Ignorable="d"
        x:Class="ShopManager.Desktop.Views.SaleHistoryWindow"
        Title="سابقه فروش"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="False"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource AppBackground}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- ═══════════ هدر ═══════════ -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24,16">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconHistory}" Width="22" Height="22"
                                       Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="سابقه فروش"
                           FontSize="18" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══════════ فیلتر بازه تاریخ ═══════════ -->
        <Border Grid.Row="1"
                Background="White"
                Padding="20,16"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="از تاریخ"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,0,6"/>
                    <TextBox x:Name="FromDateBox"
                             Width="140"
                             PlaceholderText="1405/01/01"
                             FontSize="14" Padding="12,10"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="تا تاریخ"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondary}" Margin="0,0,0,6"/>
                    <TextBox x:Name="ToDateBox"
                             Width="140"
                             PlaceholderText="1405/12/29"
                             FontSize="14" Padding="12,10"/>
                </StackPanel>

                <Button FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource AppTableRow}" Foreground="{DynamicResource AppTextPrimary}"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                        Padding="16,10"
                        Margin="0,24,0,0"
                        Click="OnTodayClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconCalendarToday}" Width="16" Height="16"
                                               Foreground="{DynamicResource AppTextPrimary}"/>
                        <TextBlock Text="امروز" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource AppTableRow}" Foreground="{DynamicResource AppTextPrimary}"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                        Padding="16,10"
                        Margin="0,24,0,0"
                        Click="OnWeekClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconCalendarWeek}" Width="16" Height="16"
                                               Foreground="{DynamicResource AppTextPrimary}"/>
                        <TextBlock Text="این هفته" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource AppTableRow}" Foreground="{DynamicResource AppTextPrimary}"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                        Padding="16,10"
                        Margin="0,24,0,0"
                        Click="OnMonthClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconCalendarMonth}" Width="16" Height="16"
                                               Foreground="{DynamicResource AppTextPrimary}"/>
                        <TextBlock Text="این ماه" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource AppTableRow}" Foreground="{DynamicResource AppTextPrimary}"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                        Padding="16,10"
                        Margin="0,24,0,0"
                        Click="OnAllClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconHistory}" Width="16" Height="16"
                                               Foreground="{DynamicResource AppTextPrimary}"/>
                        <TextBlock Text="همه سوابق" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button FontSize="14" FontWeight="Bold"
                        Background="{DynamicResource AppAccent}" Foreground="White"
                        Padding="20,10"
                        Margin="0,24,0,0"
                        Click="OnApplyFilterClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconFilter}" Width="16" Height="16" Foreground="White"/>
                        <TextBlock Text="اعمال فیلتر" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <!-- ═══════════ جستجو ═══════════ -->
        <Border Grid.Row="2"
                Background="White"
                Padding="20,12"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                            Margin="0,0,10,0" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconMagnify}" Width="18" Height="18"
                                           Foreground="{DynamicResource AppTextMuted}"
                                           VerticalAlignment="Center"/>
                    <TextBlock Text="جستجو:"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox Grid.Column="1"
                         x:Name="SearchBox"
                         PlaceholderText="جستجو بر اساس کد یا نام کالا..."
                         FontSize="14" Padding="12,10"
                         TextChanged="OnSearchChanged"/>
            </Grid>
        </Border>

        <!-- ═══════════ جدول ═══════════ -->
        <Border Grid.Row="3"
                Background="{DynamicResource AppCardBackground}"
                Margin="20"
                CornerRadius="6"
                BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">

                <!-- سرستون‌ها -->
                <Border Grid.Row="0" Background="#F1F5F9" Padding="15,14"
                        CornerRadius="6,6,0,0">
                    <Grid ColumnDefinitions="100,70,*,60,70,110,120,110,110,80">
                        <TextBlock Grid.Column="0" Text="تاریخ" FontWeight="Bold" FontSize="13"
                                   Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="کد" FontWeight="Bold" FontSize="13"
                                   Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="نام کالا" FontWeight="Bold" FontSize="13"
                                   Foreground="#0F172A"/>
                        <TextBlock Grid.Column="3" Text="واحد" FontWeight="Bold" FontSize="13"
                                   Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="تعداد" FontWeight="Bold" FontSize="13"
                                   Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="قیمت فروش" FontWeight="Bold" FontSize="13"
                                   Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="درآمد" FontWeight="Bold" FontSize="13"
                                   Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="بهای تمام" FontWeight="Bold" FontSize="13"
                                   Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="8" Text="سود" FontWeight="Bold" FontSize="13"
                                   Foreground="#0F172A" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="9" Text="پرداخت" FontWeight="Bold" FontSize="13"
                                   Foreground="#0F172A" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- سطرها -->
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="HistoryScrollViewer">
                        <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:SaleHistoryRow">
                                    <Border Padding="15,12" BorderBrush="#F1F5F9"
                                            BorderThickness="0,0,0,1" Background="White">
                                        <Grid ColumnDefinitions="100,70,*,60,70,110,120,110,110,80">
                                            <TextBlock Grid.Column="0" Text="{Binding DateShamsi}"
                                                       Foreground="#0F172A" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ItemCode}"
                                                       FontWeight="SemiBold" Foreground="#0F172A"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ItemName}"
                                                       Foreground="#0F172A"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Unit}"
                                                       Foreground="#475569" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Qty}"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource AppAccent}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding SaleUnitPrice}"
                                                       Foreground="#475569" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding Revenue}"
                                                       FontWeight="Bold" Foreground="{DynamicResource AppSuccess}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="7" Text="{Binding LockedCost}"
                                                       Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="8" Text="{Binding Profit}"
                                                       FontWeight="Bold" Foreground="{DynamicResource AppSuccess}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="9" Text="{Binding PaymentType}"
                                                       FontSize="12" Foreground="#475569"
                                                       HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <!-- حالت خالی -->
                    <StackPanel x:Name="EmptyPanel"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="15">
                        <PathIcon Data="{StaticResource IconHistory}" Width="60" Height="60"
                                               Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyTitle"
                                   Text="در این بازه فروشی ثبت نشده"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#0F172A" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════ پایین: خلاصه + دکمه‌ها ═══════════ -->
        <Border Grid.Row="4"
                Background="{DynamicResource AppCardBackground}"
                Padding="20,16"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="25">
                    <StackPanel>
                        <TextBlock Text="تعداد اقلام" FontSize="12" Foreground="{DynamicResource AppTextMuted}"/>
                        <TextBlock x:Name="TotalCountText" Text="۰"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimary}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="جمع درآمد" FontSize="12" Foreground="{DynamicResource AppTextMuted}"/>
                        <TextBlock x:Name="TotalRevenueText" Text="۰ تومان"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource AppSuccess}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="جمع سود" FontSize="12" Foreground="{DynamicResource AppTextMuted}"/>
                        <TextBlock x:Name="TotalProfitText" Text="۰ تومان"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource AppSuccess}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="نقدی" FontSize="12" Foreground="{DynamicResource AppTextMuted}"/>
                        <TextBlock x:Name="CashTotalText" Text="۰ تومان"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource AppSuccess}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="نسیه" FontSize="12" Foreground="{DynamicResource AppTextMuted}"/>
                        <TextBlock x:Name="CreditTotalText" Text="۰ تومان"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource AppWarning}"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource AppSuccess}" Foreground="White"
                        Padding="18,10"
                        Margin="0,0,10,0"
                        Click="OnExportExcelClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconFileExport}" Width="16" Height="16" Foreground="White"/>
                        <TextBlock Text="خروجی اکسل" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource AppTableRow}" Foreground="{DynamicResource AppTextPrimary}"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                        Padding="18,10"
                        Margin="0,0,10,0"
                        Click="OnPrintClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconPrinter}" Width="16" Height="16"
                                               Foreground="{DynamicResource AppTextPrimary}"/>
                        <TextBlock Text="چاپ" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3"
                        FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource AppTableRow}" Foreground="{DynamicResource AppTextPrimary}"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                        Padding="22,10"
                        Click="OnCloseClick">
                    <TextBlock Text="بستن"/>
                </Button>

            </Grid>
        </Border>

    </Grid>

</Window>
