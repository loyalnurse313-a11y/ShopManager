<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ShopManager.Desktop.ViewModels"
        mc:Ignorable="d"
        x:Class="ShopManager.Desktop.Views.TransferHistoryWindow"
        Title="سابقه انتقال"
        Width="1200" Height="720"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource AppBackground}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- هدر -->
        <Border Grid.Row="0" 
                Background="{DynamicResource AppHeaderBackground}" 
                Padding="24,18">
            <TextBlock Text="سابقه انتقال انبار به مغازه"
                       FontSize="20" FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- فیلتر بازه تاریخ -->
        <Border Grid.Row="1" 
                Background="{DynamicResource AppCardBackground}" 
                Padding="20,16"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="از تاریخ" FontSize="13" FontWeight="SemiBold" 
                               Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,6"/>
                    <TextBox x:Name="FromDateBox" Width="140"
                             Watermark="1405/01/01"
                             FontSize="14" Padding="12,10"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="تا تاریخ" FontSize="13" FontWeight="SemiBold" 
                               Foreground="{DynamicResource AppTextPrimary}" Margin="0,0,0,6"/>
                    <TextBox x:Name="ToDateBox" Width="140"
                             Watermark="1405/12/29"
                             FontSize="14" Padding="12,10"/>
                </StackPanel>

                <Button Content="امروز" FontSize="14" FontWeight="SemiBold"
                        Background="#EEF2FF" Foreground="#4F46E5"
                        Padding="16,10" Margin="0,24,0,0" CornerRadius="8"
                        Click="OnTodayClick"/>
                <Button Content="این هفته" FontSize="14" FontWeight="SemiBold"
                        Background="#EEF2FF" Foreground="#4F46E5"
                        Padding="16,10" Margin="0,24,0,0" CornerRadius="8"
                        Click="OnWeekClick"/>
                <Button Content="این ماه" FontSize="14" FontWeight="SemiBold"
                        Background="#EEF2FF" Foreground="#4F46E5"
                        Padding="16,10" Margin="0,24,0,0" CornerRadius="8"
                        Click="OnMonthClick"/>
                <Button Content="همه سوابق" FontSize="14" FontWeight="SemiBold"
                        Background="#FEF3C7" Foreground="#D97706"
                        Padding="16,10" Margin="0,24,0,0" CornerRadius="8"
                        Click="OnAllClick"/>
                <Button Content="اعمال فیلتر" FontSize="14" FontWeight="Bold"
                        Background="{DynamicResource AppAccent}" Foreground="White"
                        Padding="20,10" Margin="0,24,0,0" CornerRadius="8"
                        Click="OnApplyFilterClick"/>
            </StackPanel>
        </Border>

        <!-- جستجو -->
        <Border Grid.Row="2" 
                Background="{DynamicResource AppCardBackground}" 
                Padding="20,12"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="جستجو:"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimary}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBox Grid.Column="1"
                         x:Name="SearchBox"
                         Watermark="جستجو بر اساس کد یا نام کالا..."
                         FontSize="14" Padding="12,10"
                         TextChanged="OnSearchChanged"/>
            </Grid>
        </Border>

        <!-- جدول -->
        <Border Grid.Row="3" 
                Background="{DynamicResource AppCardBackground}" 
                Margin="20" CornerRadius="12"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1">
            <Grid RowDefinitions="Auto,*">

                <Border Grid.Row="0" 
                        Background="{DynamicResource AppTableHeader}" 
                        Padding="15,14"
                        CornerRadius="12,12,0,0">
                    <Grid ColumnDefinitions="110,80,*,80,100,*">
                        <TextBlock Grid.Column="0" Text="تاریخ" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="کد" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="نام کالا" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="واحد" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="تعداد" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="توضیحات" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource AppTableHeaderText}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="HistoryScrollViewer">
                        <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:TransferHistoryRow">
                                    <Border Padding="15,12"
                                            BorderBrush="{DynamicResource AppTableBorder}"
                                            BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="110,80,*,80,100,*">
                                            <TextBlock Grid.Column="0" Text="{Binding DateShamsi}"
                                                       Foreground="{DynamicResource AppTextPrimary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ItemCode}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextPrimary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ItemName}"
                                                       Foreground="{DynamicResource AppTextPrimary}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Unit}"
                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Qty}"
                                                       FontWeight="Bold"
                                                       Foreground="#4F46E5"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Note}"
                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <StackPanel x:Name="EmptyPanel"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="15" IsVisible="False">
                        <TextBlock Text="🚚" FontSize="60" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyTitle"
                                   Text="در این بازه انتقالی ثبت نشده"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- پایین -->
        <Border Grid.Row="4" 
                Background="{DynamicResource AppCardBackground}" 
                Padding="20,16"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="25">
                    <StackPanel>
                        <TextBlock Text="تعداد اقلام" FontSize="12" 
                                   Foreground="{DynamicResource AppTextSecondary}"/>
                        <TextBlock x:Name="TotalCountText" Text="۰"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimary}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="جمع تعداد" FontSize="12" 
                                   Foreground="{DynamicResource AppTextSecondary}"/>
                        <TextBlock x:Name="TotalQtyText" Text="۰"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="#4F46E5"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="خروجی اکسل"
                        FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource AppSuccess}" Foreground="White"
                        Padding="18,10" Margin="0,0,10,0" CornerRadius="8"
                        Click="OnExportExcelClick"/>

                <Button Grid.Column="2"
                        Content="چاپ"
                        FontSize="14" FontWeight="SemiBold"
                        Background="#8B5CF6" Foreground="White"
                        Padding="18,10" Margin="0,0,10,0" CornerRadius="8"
                        Click="OnPrintClick"/>

                <Button Grid.Column="3"
                        Content="بروزرسانی"
                        FontSize="14" FontWeight="SemiBold"
                        Background="{DynamicResource AppBackground}" 
                        Foreground="{DynamicResource AppTextPrimary}"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                        Padding="18,10" Margin="0,0,10,0" CornerRadius="8"
                        Click="OnRefreshClick"/>

                <Button Grid.Column="4"
                        Content="بستن"
                        FontSize="14"
                        Background="{DynamicResource AppBackground}"
                        Foreground="{DynamicResource AppTextPrimary}"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                        Padding="22,10" CornerRadius="8"
                        Click="OnCloseClick"/>
            </Grid>
        </Border>

    </Grid>

</Window>