<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ShopManager.Desktop.ViewModels"
        mc:Ignorable="d"
        x:Class="ShopManager.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="فروشگاه"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="False"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource AppBackground}">

    <Window.Styles>
        <!-- دکمه منو -->
        <Style Selector="Button.menuItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMenuText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style Selector="Button.menuItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E293B"/>
        </Style>

        <Style Selector="Button.menuItem:pointerover">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- دکمه فعال -->
        <Style Selector="Button.menuItemActive">
            <Setter Property="Background" Value="{DynamicResource AppAccent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.menuItemActive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccent}"/>
        </Style>

        <!-- آیکون منو -->
        <Style Selector="PathIcon.menuIcon">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="56,*,32">

        <!-- ═══════════════════════════════════════
             هدر بالا
             ═══════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource AppHeaderBackground}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="20,0">

                <!-- لوگو + نام فروشگاه -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconStore}"
                                           Width="22" Height="22"
                                           Foreground="#3B82F6"/>
                    <TextBlock Text="فروشگاه"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- ساعت -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconClockOutline}"
                                           Width="16" Height="16"
                                           Foreground="#94A3B8"/>
                    <TextBlock x:Name="ClockText"
                               Text=""
                               FontSize="13"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- دکمه بروزرسانی -->
                <Button Grid.Column="2"
                        x:Name="UpdateButton"
                        Content="🔄 بروزرسانی"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Background="#F59E0B"
                        Foreground="White"
                        Padding="12,6"
                        CornerRadius="6"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        IsVisible="False"
                        Click="OnUpdateClick"/>

                <!-- نام کاربر -->
                <Border Grid.Column="3"
                        Background="#1E293B"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconAccountCircle}"
                                               Width="16" Height="16"
                                               Foreground="#94A3B8"/>
                        <TextBlock x:Name="UserInfoText"
                                   Text=""
                                   FontSize="13"
                                   Foreground="#E2E8F0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- دکمه خروج -->
                <Button Grid.Column="4"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Background="#B91C1C"
                        Foreground="White"
                        Padding="14,6"
                        CornerRadius="6"
                        VerticalAlignment="Center"
                        Click="OnLogoutClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconLogout}"
                                               Width="16" Height="16"
                                               Foreground="White"/>
                        <TextBlock Text="خروج" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════
             بدنه: Sidebar + محتوا
             ═══════════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="240,*">

            <!-- ─── Sidebar راست ─── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource AppMenuBackground}"
                    Padding="12,16">
                <ScrollViewer>
                    <StackPanel Spacing="2">

                        <!-- بخش اصلی -->
                        <TextBlock Text="منوی اصلی"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"
                                   Margin="12,4,12,10"/>

                        <Button x:Name="DashboardButton"
                                Classes="menuItem menuItemActive"
                                Click="OnDashboardClick">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconViewDashboard}"
                                                       Classes="menuIcon"/>
                                <TextBlock Text="داشبورد" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ItemsButton"
                                Classes="menuItem"
                                Click="OnItemsClick">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconPackage}"
                                                       Classes="menuIcon"/>
                                <TextBlock Text="کالاها" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="PurchaseButton"
                                Classes="menuItem"
                                Click="OnPurchaseClick">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconCartPlus}"
                                                       Classes="menuIcon"/>
                                <TextBlock Text="خرید" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TransferButton"
                                Classes="menuItem"
                                Click="OnTransferClick">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconTruck}"
                                                       Classes="menuIcon"/>
                                <TextBlock Text="انتقال به مغازه" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="POSButton"
                                Classes="menuItem"
                                Click="OnPOSClick">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconPointOfSale}"
                                                       Classes="menuIcon"/>
                                <TextBlock Text="صندوق فروش (POS)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="CustomersButton"
                                Classes="menuItem"
                                Click="OnCustomersClick">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconAccountGroup}"
                                                       Classes="menuIcon"/>
                                <TextBlock Text="مشتری‌ها" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="CashboxButton"
                                Classes="menuItem"
                                Click="OnCashboxClick">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconWallet}"
                                                       Classes="menuIcon"/>
                                <TextBlock Text="صندوق" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- جداکننده -->
                        <Border Height="1"
                                Background="#1E293B"
                                Margin="8,12,8,12"/>

                        <!-- بخش مدیریتی -->
                        <TextBlock Text="مدیریت"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"
                                   Margin="12,4,12,10"/>

                        <Button x:Name="UserManagementButton"
                                Classes="menuItem"
                                IsVisible="False"
                                Click="OnUserManagementClick">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconAccountCog}"
                                                       Classes="menuIcon"/>
                                <TextBlock Text="مدیریت کاربران" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="SettingsButton"
                                Classes="menuItem"
                                Click="OnSettingsClick">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconCog}"
                                                       Classes="menuIcon"/>
                                <TextBlock Text="تنظیمات" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ─── محتوای وسط ─── -->
            <Border Grid.Column="1"
                    Background="{DynamicResource AppBackground}"
                    Padding="40,32">
                <ScrollViewer>
                    <StackPanel Spacing="28" MaxWidth="900" HorizontalAlignment="Center">

                        <!-- ─── خوش‌آمد ─── -->
                        <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <TextBlock x:Name="WelcomeText"
                                       Text="خوش آمدید"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimary}"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="WelcomeSubText"
                                       Text="برای شروع، یکی از گزینه‌های منو رو انتخاب کنید"
                                       FontSize="14"
                                       Foreground="{DynamicResource AppTextSecondary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- ─── کارت‌های سریع ─── -->
                        <TextBlock Text="دسترسی سریع"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   Margin="4,0,0,0"/>

                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">

                            <Button Width="180" Height="100"
                                    Margin="6"
                                    Background="{DynamicResource AppCardBackground}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Cursor="Hand"
                                    Click="OnPOSClick">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconPointOfSale}"
                                                           Width="28" Height="28"
                                                           Foreground="{DynamicResource AppAccent}"/>
                                    <TextBlock Text="فروش سریع"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimary}"/>
                                </StackPanel>
                            </Button>

                            <Button Width="180" Height="100"
                                    Margin="6"
                                    Background="{DynamicResource AppCardBackground}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Cursor="Hand"
                                    Click="OnItemsClick">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconPackage}"
                                                           Width="28" Height="28"
                                                           Foreground="{DynamicResource AppAccent}"/>
                                    <TextBlock Text="مدیریت کالاها"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimary}"/>
                                </StackPanel>
                            </Button>

                            <Button Width="180" Height="100"
                                    Margin="6"
                                    Background="{DynamicResource AppCardBackground}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Cursor="Hand"
                                    Click="OnPurchaseClick">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconCartPlus}"
                                                           Width="28" Height="28"
                                                           Foreground="{DynamicResource AppAccent}"/>
                                    <TextBlock Text="ثبت خرید"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimary}"/>
                                </StackPanel>
                            </Button>

                            <Button Width="180" Height="100"
                                    Margin="6"
                                    Background="{DynamicResource AppCardBackground}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Cursor="Hand"
                                    Click="OnDashboardClick">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconChartLine}"
                                                           Width="28" Height="28"
                                                           Foreground="{DynamicResource AppAccent}"/>
                                    <TextBlock Text="گزارش‌ها"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimary}"/>
                                </StackPanel>
                            </Button>

                        </WrapPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════
             فوتر
             ═══════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource AppCardBackground}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,0">
                <TextBlock Grid.Column="0"
                           Text="آماده"
                           FontSize="12"
                           Foreground="{DynamicResource AppTextSecondary}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="سیستم مدیریت فروشگاه — نسخه ۱.۰.۷"
                           FontSize="12"
                           Foreground="{DynamicResource AppTextMuted}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>

</Window>
