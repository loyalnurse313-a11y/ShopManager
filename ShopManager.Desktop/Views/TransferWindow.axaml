<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ShopManager.Desktop.Views.TransferWindow"
        Title="انتقال به مغازه"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="False"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn,IRANSans,Segoe UI"
        Background="#F1F5F9">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- هدر -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24,16">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource IconTruck}" Width="20" Height="20"
                          Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="انتقال کالا از انبار به مغازه"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- فرم -->
        <ScrollViewer Grid.Row="1">
            <Border Background="{DynamicResource AppCardBackground}" Margin="20" Padding="28" CornerRadius="6">
                <StackPanel Spacing="18">

                    <!-- تاریخ -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                            <TextBlock Text="تاریخ (شمسی)" 
                                       FontSize="14" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Text="*" FontSize="14" FontWeight="Bold" Foreground="#EF4444"/>
                        </StackPanel>
                        <TextBox x:Name="DateTextBox" 
                                 PlaceholderText="مثال: 1405/07/05"
                                 FontSize="15" Padding="14,12"/>
                    </StackPanel>

                    <!-- کد کالا + نام -->
                    <Grid ColumnDefinitions="240,16,*">
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                                <TextBlock Text="کد یا نام کالا" 
                                           FontSize="14" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBlock Text="*" FontSize="14" FontWeight="Bold" Foreground="#EF4444"/>
                            </StackPanel>
                            <AutoCompleteBox x:Name="ItemSearchBox"
                                             PlaceholderText="کد یا نام کالا..."
                                             FontSize="15" Padding="14,12"
                                             FilterMode="Contains"
                                             MinimumPrefixLength="1"
                                             SelectionChanged="OnItemSelected"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="نام کالا (خودکار)" 
                                       FontSize="14" FontWeight="SemiBold" Foreground="#334155"
                                       Margin="0,0,0,8"/>
                            <Border Background="#F8FAFC" 
                                    CornerRadius="6" 
                                    Padding="14,10"
                                    MinHeight="40">
                                <TextBlock x:Name="ItemNameText" 
                                           Text="—"
                                           FontSize="15"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- موجودی انبار — کارت سفید با نوار کناری Accent -->
                    <Border Background="{DynamicResource AppCardBackground}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid ColumnDefinitions="3,*">
                            <Border Grid.Column="0" Background="{DynamicResource AppAccent}" CornerRadius="0,6,6,0"/>
                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="18,14">
                                <TextBlock Grid.Column="0"
                                           Text="موجودی فعلی انبار:"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppAccent}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="WarehouseStockText"
                                           Text="—"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource AppAccent}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- تعداد -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                            <TextBlock Text="تعداد منتقل‌شده" 
                                       FontSize="14" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Text="*" FontSize="14" FontWeight="Bold" Foreground="#EF4444"/>
                        </StackPanel>
                        <TextBox x:Name="QtyTextBox" 
                                 PlaceholderText="مثال: 50"
                                 FontSize="15" Padding="14,12"
                                 TextChanged="OnQtyChanged"/>
                    </StackPanel>

                    <!-- پیش‌نمایش موجودی بعد — کارت سفید با نوار کناری سبز -->
                    <Border Background="{DynamicResource AppCardBackground}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid ColumnDefinitions="3,*">
                            <Border Grid.Column="0" Background="{DynamicResource AppSuccess}" CornerRadius="0,6,6,0"/>
                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="18,14">
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="موجودی انبار پس از انتقال:"
                                           FontSize="14" Foreground="{DynamicResource AppSuccess}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           x:Name="WarehouseAfterText"
                                           Text="—"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource AppSuccess}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="موجودی مغازه پس از انتقال:"
                                           FontSize="14" Foreground="{DynamicResource AppSuccess}"
                                           VerticalAlignment="Center"
                                           Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           x:Name="ShopAfterText"
                                           Text="—"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource AppSuccess}"
                                           Margin="0,8,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- توضیحات -->
                    <StackPanel>
                        <TextBlock Text="توضیحات (اختیاری)" 
                                   FontSize="14" FontWeight="SemiBold" Foreground="#334155"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="NoteTextBox" 
                                 MaxLength="500"
                                 PlaceholderText="مثال: شارژ هفتگی مغازه"
                                 FontSize="15" Padding="14,12"/>
                    </StackPanel>

                    <!-- لیست انتقال‌های امروز -->
                    <StackPanel>
                        <TextBlock Text="انتقال‌های امروز" 
                                   FontSize="14" FontWeight="SemiBold" Foreground="#334155"
                                   Margin="0,10,0,8"/>
                        <Border Background="#F8FAFC" 
                                CornerRadius="6" 
                                Padding="10"
                                MinHeight="120"
                                MaxHeight="200">
                            <ScrollViewer>
                                <StackPanel x:Name="TodayTransfersPanel" Spacing="6">
                                    <TextBlock Text="هنوز انتقالی ثبت نشده"
                                               Foreground="#94A3B8"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               Margin="0,30,0,30"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- پایین: پیام + دکمه‌ها -->
        <Border Grid.Row="2" 
                Background="{DynamicResource AppCardBackground}" 
                Padding="24,18"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">

                <TextBlock Grid.Column="0"
                           x:Name="StatusText"
                           Text=""
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppDanger}"
                           TextWrapping="Wrap"/>

                <!-- سابقه انتقال -->
                <Button Grid.Column="1"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="{DynamicResource AppTableHeader}"
                        Foreground="{DynamicResource AppTextPrimary}"
                        Padding="18,12"
                        Margin="0,0,10,0"
                        CornerRadius="6"
                        Click="OnHistoryClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconHistory}" Width="16" Height="16"
                                   Foreground="{DynamicResource AppTextPrimary}"/>
                        <TextBlock Text="سابقه انتقال" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- بستن -->
                <Button Grid.Column="2"
                        Content="بستن"
                        FontSize="15"
                        Padding="28,12"
                        Margin="0,0,10,0"
                        Background="{DynamicResource AppBackground}"
                        Foreground="{DynamicResource AppTextPrimary}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Click="OnCancelClick"/>

                <!-- ثبت انتقال -->
                <Button Grid.Column="3"
                        FontSize="15"
                        FontWeight="Bold"
                        Padding="28,12"
                        Background="{DynamicResource AppAccent}"
                        Foreground="White"
                        CornerRadius="6"
                        Click="OnSaveClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconCheck}" Width="16" Height="16" Foreground="White"/>
                        <TextBlock Text="ثبت انتقال" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

    </Grid>

</Window>