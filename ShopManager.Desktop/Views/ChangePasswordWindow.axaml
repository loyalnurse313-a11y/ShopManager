<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ShopManager.Desktop.Views.ChangePasswordWindow"
        Title="تغییر رمز عبور ضروری"
        Width="500" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn,IRANSans,Segoe UI"
        Background="#F1F5F9">

    <Grid RowDefinitions="Auto,*">

        <!-- ─── هدر ─── -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24,20">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource IconLock}"
                          Width="22" Height="22"
                          Foreground="White"
                          VerticalAlignment="Center"/>
                <TextBlock Text="تغییر رمز عبور ضروری"
                           FontSize="20" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ─── محتوای وسط ─── -->
        <StackPanel Grid.Row="1" Margin="24" Spacing="14">

            <!-- هشدار امنیتی — نوار کناری نارنجی ملایم -->
            <Border Background="#FFF7ED"
                    BorderBrush="#FED7AA"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid ColumnDefinitions="3,*">
                    <Border Grid.Column="0" Background="#B45309" CornerRadius="0,6,6,0"/>
                    <TextBlock Grid.Column="1"
                               Text="برای امنیت، باید رمز پیش‌فرض رو تغییر بدی. رمز جدید باید حداقل ۸ کاراکتر، شامل حرف و عدد باشه."
                               FontSize="13"
                               Foreground="#B45309"
                               TextWrapping="Wrap"
                               Margin="12,10"/>
                </Grid>
            </Border>

            <TextBlock Text="رمز جدید:"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="#334155"/>

            <TextBox x:Name="NewPasswordBox"
                     PasswordChar="●"
                     PlaceholderText="حداقل ۸ کاراکتر"
                     MinHeight="40"
                     FontSize="14"
                     Padding="12,10"
                     BorderBrush="{DynamicResource AppBorder}"
                     CornerRadius="6"/>

            <TextBlock Text="تکرار رمز جدید:"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="#334155"/>

            <TextBox x:Name="ConfirmPasswordBox"
                     PasswordChar="●"
                     MinHeight="40"
                     FontSize="14"
                     Padding="12,10"
                     BorderBrush="{DynamicResource AppBorder}"
                     CornerRadius="6"/>

            <!-- پیام خطا — فقط متن قرمز، بدون پس‌زمینه رنگی -->
            <Border x:Name="MessageBorder"
                    IsVisible="False"
                    CornerRadius="6"
                    Padding="0">
                <TextBlock x:Name="MessageText"
                           Text=""
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppDanger}"
                           TextWrapping="Wrap"/>
            </Border>

            <Button x:Name="SaveButton"
                    Background="{DynamicResource AppAccent}"
                    Foreground="White"
                    Padding="30,14"
                    CornerRadius="6"
                    FontSize="15"
                    FontWeight="Bold"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Click="OnSaveClick">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <PathIcon Data="{StaticResource IconContentSave}" Width="18" Height="18" Foreground="White"/>
                    <TextBlock Text="ذخیره رمز جدید" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- دکمه انصراف — بستن برنامه -->
            <Button x:Name="CancelButton"
                    Content="انصراف"
                    Background="{DynamicResource AppBackground}"
                    Foreground="{DynamicResource AppTextPrimary}"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1"
                    Padding="30,12"
                    CornerRadius="6"
                    FontSize="14"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Click="OnCloseClick"/>

        </StackPanel>
    </Grid>

</Window>
