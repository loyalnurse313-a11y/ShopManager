<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ShopManager.Desktop.ViewModels"
        mc:Ignorable="d"
        x:Class="ShopManager.Desktop.Views.POSWindow"
        Title="صندوق فروش (POS)"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="False"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn,IRANSans,Segoe UI"
        Background="{DynamicResource AppBackground}"
        KeyDown="OnWindowKeyDown">

    <Window.Styles>
        <!-- دکمه‌های عملیاتی POS -->
        <Style Selector="Button.posAction">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- دکمه پرداخت (بزرگ) -->
        <Style Selector="Button.payButton">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="30,20"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="80"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- مبلغ کل -->
        <Style Selector="TextBlock.hugeAmount">
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══════════ هدر بالا ═══════════ -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,14">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- شماره فاکتور -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconReceiptText}" Width="20" Height="20"
                                           Foreground="#F59E0B"
                                           VerticalAlignment="Center"/>
                    <TextBlock Text="فاکتور:" FontSize="14" Foreground="#94A3B8"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="InvoiceNoText"
                               Text="—"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#F59E0B"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- پایانه POS فعال (وسط) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconWallet}" Width="18" Height="18"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                    <TextBlock Text="پایانه POS فعال:" FontSize="14" Foreground="#94A3B8"
                               VerticalAlignment="Center"/>
                    <ComboBox x:Name="POSTerminalCombo"
                              Width="240"
                              FontSize="14"
                              Padding="12,8"
                              Background="#1E293B"
                              Foreground="White"
                              BorderBrush="{DynamicResource AppBorder}"
                              BorderThickness="1"
                              CornerRadius="6"/>
                </StackPanel>

                <!-- ساعت -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconClockOutline}" Width="16" Height="16"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"/>
                    <TextBlock x:Name="ClockText"
                               Text=""
                               FontSize="14"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ محتوای اصلی ═══════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,20,420">

            <!-- ستون سبد (راست) -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" Margin="16,16,8,0">

                <!-- هدر سبد -->
                <Border Grid.Row="0" Background="#0F172A" CornerRadius="6,6,0,0" Padding="20,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconCart}" Width="22" Height="22"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                            <TextBlock Text="سبد فروش"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                            <Border Background="#F59E0B" CornerRadius="6" Padding="10,4">
                                <TextBlock x:Name="CartCountText"
                                           Text="۰ قلم"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- اطلاعات مشتری -->
                <Border Grid.Row="1"
                        Background="Transparent"
                        Padding="20,14"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,16,*">

                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconAccountOutline}" Width="14" Height="14"
                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                       VerticalAlignment="Center"/>
                                <TextBlock Text="نام مشتری"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="(اختیاری)"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox x:Name="CustomerNameBox"
                                     PlaceholderText="مثال: علی رضایی"
                                     FontSize="14"
                                     Padding="12,8"
                                     Background="White"
                                     BorderBrush="{DynamicResource AppBorder}"
                                     BorderThickness="1"
                                     CornerRadius="6"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconPhoneOutline}" Width="14" Height="14"
                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                       VerticalAlignment="Center"/>
                                <TextBlock Text="شماره تماس"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="(اختیاری)"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox x:Name="CustomerPhoneBox"
                                     PlaceholderText="مثال: 09123456789"
                                     FontSize="14"
                                     Padding="12,8"
                                     Background="White"
                                     BorderBrush="{DynamicResource AppBorder}"
                                     BorderThickness="1"
                                     CornerRadius="6"
                                     TextChanged="OnCustomerPhoneChanged"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- جدول اقلام سبد -->
                <Border Grid.Row="2" Background="White"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
                    <Grid RowDefinitions="Auto,*">

                        <Border Grid.Row="0" Background="{DynamicResource AppBackground}" Padding="14,10">
                            <Grid ColumnDefinitions="*,140,80,110,120,60">
                                <TextBlock Grid.Column="0" Text="کالا"
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource AppTextSecondary}"/>
                                <TextBlock Grid.Column="1" Text="تعداد"
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="واحد"
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="قیمت"
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="جمع"
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text=""
                                           FontWeight="Bold" FontSize="14"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="CartScrollViewer">
                                <StackPanel x:Name="CartPanel" Spacing="0"/>
                            </ScrollViewer>

                            <StackPanel x:Name="EmptyCartPanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="14"
                                        IsVisible="True">
                                <PathIcon Data="{StaticResource IconCart}" Width="70" Height="70"
                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                       HorizontalAlignment="Center"/>
                                <TextBlock Text="سبد خالی است"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="بارکد رو اسکن کن یا از لیست کالاها انتخاب کن"
                                           FontSize="14"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- پنل جمع + پرداخت -->
                <Border Grid.Row="3" Background="White"
                        CornerRadius="0,0,6,6"
                        Padding="20,16"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
                    <StackPanel Spacing="14">

                        <!-- ردیف تخفیف: فقط متن رنگی، بدون پس‌زمینه -->
                        <Border x:Name="DiscountRow"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="14,10"
                                IsVisible="False">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconTag}" Width="18" Height="18"
                                                           Foreground="{DynamicResource AppDanger}"
                                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="تخفیف:"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppDanger}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           x:Name="DiscountAmountText"
                                           Text="۰ تومان"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource AppDanger}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- جمع کل -->
                        <Border Background="#ECFDF5" CornerRadius="6" Padding="18,14">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconCash}" Width="22" Height="22"
                                                           Foreground="{DynamicResource AppSuccess}"
                                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="جمع کل:"
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource AppSuccess}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           x:Name="TotalAmountText"
                                           Text="۰ تومان"
                                           Classes="hugeAmount"
                                           Foreground="{DynamicResource AppSuccess}"/>
                            </Grid>
                        </Border>

                        <!-- دکمه‌های عملیاتی سبد -->
                        <Grid ColumnDefinitions="*,10,*,10,*">
                            <Button Grid.Column="0"
                                    Classes="posAction"
                                    Background="{DynamicResource AppDanger}" Foreground="White"
                                    HorizontalContentAlignment="Center"
                                    Click="OnClearCartClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconDelete}" Width="18" Height="18"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="پاک کردن" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Classes="posAction"
                                    Background="{DynamicResource AppWarning}" Foreground="White"
                                    HorizontalContentAlignment="Center"
                                    Click="OnEditQtyClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconPencil}" Width="18" Height="18"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="ویرایش تعداد" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="4"
                                    Classes="posAction"
                                    Background="{DynamicResource AppAccent}" Foreground="White"
                                    HorizontalContentAlignment="Center"
                                    Click="OnDiscountClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconTag}" Width="18" Height="18"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="تخفیف" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- دکمه پرداخت -->
                        <Button x:Name="PayButton"
                                Classes="payButton"
                                Background="{DynamicResource AppSuccess}"
                                Foreground="White"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="OnPayClick">
                            <StackPanel Orientation="Horizontal" Spacing="12"
                                        HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource IconCreditCard}" Width="26" Height="26"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"/>
                                <TextBlock Text="پرداخت  (F2)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ستون جستجو (چپ) -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto" Margin="8,16,16,0">

                <!-- بارکدخوان -->
                <Border Grid.Row="0" Background="#0F172A"
                        CornerRadius="6" Padding="20,16">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconBarcodeScan}" Width="20" Height="20"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                            <TextBlock Text="بارکدخوان / جستجو"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBox x:Name="BarcodeSearchBox"
                                 PlaceholderText="بارکد رو اسکن کن یا نام کالا رو تایپ کن..."
                                 FontSize="18"
                                 Padding="16,14"
                                 Background="#1E293B"
                                 Foreground="White"
                                 BorderBrush="{DynamicResource AppBorder}"
                                 BorderThickness="1"
                                 CornerRadius="6"
                                 KeyDown="OnSearchBoxKeyDown"
                                 TextChanged="OnSearchBoxChanged"/>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="F4: فوکوس"
                                       FontSize="12" Foreground="#94A3B8"/>
                            <TextBlock Text="Enter: افزودن"
                                       FontSize="12" Foreground="#94A3B8"/>
                            <TextBlock Text="Esc: پاک کردن"
                                       FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- نتایج جستجو -->
                <Border Grid.Row="1"
                        x:Name="SearchResultsBorder"
                        Background="White"
                        CornerRadius="6"
                        Margin="0,10,0,0"
                        MaxHeight="240"
                        IsVisible="False"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1">
                    <ScrollViewer>
                        <StackPanel x:Name="SearchResultsPanel" Spacing="0"/>
                    </ScrollViewer>
                </Border>

                <!-- تب‌های کالا -->
                <Border Grid.Row="2" Background="White"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                        CornerRadius="6" Margin="0,10,0,0">
                    <Grid RowDefinitions="Auto,*">

                        <Border Grid.Row="0" Background="{DynamicResource AppBackground}"
                                CornerRadius="6,6,0,0"
                                Padding="12,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <!-- تب فعال: پس‌زمینه AppAccent + متن سفید، تب غیرفعال: شفاف + AppTextSecondary -->
                                <Button x:Name="TabPopularBtn"
                                        Classes="posAction"
                                        Background="{DynamicResource AppAccent}"
                                        Foreground="White"
                                        HorizontalContentAlignment="Center"
                                        Margin="0,8,0,8"
                                        Click="OnTabPopularClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconStar}" Width="18" Height="18"
                                                               Foreground="{Binding $parent[Button].Foreground}"
                                                               VerticalAlignment="Center"/>
                                        <TextBlock Text="پرفروش" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TabRecentBtn"
                                        Classes="posAction"
                                        Background="Transparent"
                                        Foreground="{DynamicResource AppTextSecondary}"
                                        HorizontalContentAlignment="Center"
                                        Margin="0,8,0,8"
                                        Click="OnTabRecentClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconClockOutline}" Width="18" Height="18"
                                                               Foreground="{Binding $parent[Button].Foreground}"
                                                               VerticalAlignment="Center"/>
                                        <TextBlock Text="اخیر" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TabAllBtn"
                                        Classes="posAction"
                                        Background="Transparent"
                                        Foreground="{DynamicResource AppTextSecondary}"
                                        HorizontalContentAlignment="Center"
                                        Margin="0,8,0,8"
                                        Click="OnTabAllClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconPackage}" Width="18" Height="18"
                                                               Foreground="{Binding $parent[Button].Foreground}"
                                                               VerticalAlignment="Center"/>
                                        <TextBlock Text="همه" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" Padding="14">
                            <WrapPanel x:Name="ProductTilesPanel"
                                       Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════ نوار پایین ═══════════ -->
        <Border Grid.Row="2" Background="White" Padding="20,12"
                BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                <!-- وضعیت -->
                <Border Grid.Column="0"
                        Background="{DynamicResource AppBackground}"
                        CornerRadius="6"
                        Padding="16,10"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               Text="آماده"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondary}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="400"/>
                </Border>

                <!-- دکمه‌ها (سمت چپ) -->
                <Button Grid.Column="2"
                        Classes="posAction"
                        Background="{DynamicResource AppAccent}"
                        Foreground="White"
                        HorizontalContentAlignment="Center"
                        Margin="10,0,0,0"
                        Click="OnHistoryClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconHistory}" Width="18" Height="18"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="سابقه فروش" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3"
                        Classes="posAction"
                        Background="{DynamicResource AppWarning}"
                        Foreground="White"
                        HorizontalContentAlignment="Center"
                        Margin="10,0,0,0"
                        Click="OnPrintLastClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconPrinter}" Width="18" Height="18"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="چاپ فاکتور اخیر" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4"
                        Classes="posAction"
                        Background="{DynamicResource AppBackground}"
                        Foreground="{DynamicResource AppTextSecondary}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1"
                        HorizontalContentAlignment="Center"
                        Margin="10,0,0,0"
                        Click="OnCloseClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconClose}" Width="18" Height="18"
                                               Foreground="{DynamicResource AppTextSecondary}"
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="بستن" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
