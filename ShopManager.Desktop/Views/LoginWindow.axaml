<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ShopManager.Desktop.Views.LoginWindow"
        Title="ورود به سیستم"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn,IRANSans,Segoe UI"
        Background="#0F172A">

    <Window.Styles>
        <!-- انیمیشن ورود کارت -->
        <Style Selector="Border.LoginCard">
            <Style.Animations>
                <Animation Duration="0:0:0.7" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="30"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="TextBlock.FadeInUp">
            <Style.Animations>
                <Animation Duration="0:0:0.6" Delay="0:0:0.3" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="20"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid>
        <!-- پس‌زمینه گرادیانت مشکی/طوسی -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E293B" Offset="0.5"/>
                    <GradientStop Color="#334155" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- دایره‌های تزئینی -->
        <Ellipse Width="500" Height="500"
                 Fill="#10FFFFFF"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-200,-250,0,0"/>

        <Ellipse Width="400" Height="400"
                 Fill="#08FFFFFF"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-150,-150"/>

        <!-- محتوای وسط -->
        <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="*,Auto,*">
            <Border Grid.Column="1" Grid.Row="1"
                    Classes="LoginCard"
                    Width="420"
                    Background="#FFFFFF"
                    CornerRadius="20"
                    Padding="40,36"
                    BoxShadow="0 20 60 0 #60000000"
                    RenderTransformOrigin="50%,50%">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>

                <StackPanel Spacing="24">

                    <!-- لوگو -->
                    <Border Width="100" Height="100"
                            CornerRadius="50"
                            HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#0F172A" Offset="0"/>
                                <GradientStop Color="#475569" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="🛍️"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- عنوان -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="فروشگاه ظروف یکبار مصرف"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#0F172A"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="خوی "
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="#4F46E5"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- خط تزئینی -->
                    <Border Height="2" Background="#E2E8F0" Margin="0,8,0,8"/>

                    <!-- فرم ورود -->
                    <StackPanel Spacing="16">

                        <!-- نام کاربری -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="نام کاربری"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#334155"/>
                            <TextBox x:Name="UsernameTextBox"
                                     Watermark="نام کاربری خود را وارد کنید"
                                     FontSize="14"
                                     Padding="14,12"
                                     Background="#F8FAFC"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     CornerRadius="8"/>
                        </StackPanel>

                        <!-- رمز عبور -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="رمز عبور"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#334155"/>
                            <TextBox x:Name="PasswordTextBox"
                                     PasswordChar="●"
                                     Watermark="رمز عبور"
                                     FontSize="14"
                                     Padding="14,12"
                                     Background="#F8FAFC"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     CornerRadius="8"
                                     KeyDown="OnPasswordKeyDown"/>
                        </StackPanel>

                        <!-- پیام خطا / موفقیت -->
                        <Border x:Name="MessageBorder"
                                Background="#FEF2F2"
                                CornerRadius="8"
                                Padding="12,10"
                                IsVisible="False">
                            <TextBlock x:Name="MessageText"
                                       Text=""
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#DC2626"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- دکمه ورود -->
                        <Button x:Name="LoginButton"
                                Content="ورود به سیستم"
                                FontSize="15"
                                FontWeight="Bold"
                                Background="#4F46E5"
                                Foreground="White"
                                Padding="24,14"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                CornerRadius="10"
                                Margin="0,8,0,0"
                                Click="OnLoginClick"/>

                    </StackPanel>

                    <!-- متن پایین -->
                    <StackPanel Spacing="6" Margin="0,12,0,0">
                        <TextBlock Text="برای ورود، از حساب کاربری خود استفاده کنید"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="VersionText"
                                   Text="VersionText.Text = "نسخه ۱.۰.۱";"
                                   FontSize="10"
                                   Foreground="#CBD5E1"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

       

    </Grid>

</Window>