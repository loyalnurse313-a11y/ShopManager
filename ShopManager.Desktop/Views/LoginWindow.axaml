<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ShopManager.Desktop.Views.LoginWindow"
        Title="ورود به سیستم"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn,IRANSans,Segoe UI"
        ExtendClientAreaToDecorationsHint="False"
        Background="#0F172A">

    <!-- دو لایه روی هم: اسپلش (فاز ۱) و فرم ورود (فاز ۲) -->
    <Grid>

        <!-- ═══════════════ فاز ۱: اسپلش ═══════════════ -->
        <Border x:Name="SplashPanel" Background="#0F172A">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">

                <!-- Splash logo with scale + rotate animation (transition-based) -->
                <Border x:Name="SplashLogoBorder"
                        Width="120" Height="120"
                        Background="#1E40AF"
                        CornerRadius="60"
                        Opacity="0"
                        HorizontalAlignment="Center"
                        RenderTransformOrigin="50%,50%">
                    <Border.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform"
                                                           Duration="0:0:0.5"
                                                           Easing="CubicEaseOut"/>
                            <DoubleTransition Property="Opacity"
                                              Duration="0:0:0.5"
                                              Easing="CubicEaseOut"/>
                        </Transitions>
                    </Border.Transitions>
                    <PathIcon Data="{StaticResource IconStore}"
                              Width="60" Height="60"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>

                <!-- عنوان -->
                <TextBlock x:Name="SplashTitleText"
                           Text="فروشگاه"
                           FontSize="24" FontWeight="Bold"
                           Foreground="White"
                           Opacity="0"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>

                <!-- زیرعنوان -->
                <TextBlock x:Name="SplashSubtitleText"
                           Text="سیستم مدیریت فروش"
                           FontSize="14"
                           Foreground="#94A3B8"
                           Opacity="0"
                           HorizontalAlignment="Center"/>

                <!-- نوار پیشرفت -->
                <Border Width="200" Height="3"
                        Background="#1E293B"
                        CornerRadius="2"
                        Margin="0,18,0,0"
                        ClipToBounds="True"
                        HorizontalAlignment="Center">
                    <Border x:Name="SplashProgressBar"
                            Width="0" Height="3"
                            Background="#3B82F6"
                            CornerRadius="2"
                            HorizontalAlignment="Left"/>
                </Border>

                <!-- متن لودینگ -->
                <TextBlock x:Name="SplashLoadingText"
                           Text="در حال آماده‌سازی..."
                           FontSize="12"
                           Foreground="#64748B"
                           Opacity="0"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════ فاز ۲: فرم ورود ═══════════════ -->
        <Border x:Name="LoginPanel"
                Width="380"
                Background="#FFFFFF"
                CornerRadius="8"
                Padding="32,28"
                Opacity="0"
                IsVisible="False"
                BoxShadow="0 4 16 0 #25000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel Spacing="18">

                <!-- لوگوی کوچک -->
                <Border Width="60" Height="60"
                        Background="#1E40AF"
                        CornerRadius="30"
                        HorizontalAlignment="Center">
                    <PathIcon Data="{StaticResource IconStore}"
                              Width="32" Height="32"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>

                <!-- نام فروشگاه -->
                <TextBlock Text="فروشگاه"
                           FontSize="16" FontWeight="Bold"
                           Foreground="#0F172A"
                           HorizontalAlignment="Center"/>

                <!-- جداکننده -->
                <Border Height="1" Background="#E2E8F0"/>

                <!-- فیلد نام کاربری -->
                <StackPanel Spacing="6">
                    <TextBlock Text="نام کاربری"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#334155"/>
                    <TextBox x:Name="UsernameTextBox"
                             PlaceholderText="نام کاربری خود را وارد کنید"
                             MinHeight="38"
                             FontSize="14"
                             Padding="12,8"
                             CornerRadius="6"/>
                </StackPanel>

                <!-- فیلد رمز عبور -->
                <StackPanel Spacing="6">
                    <TextBlock Text="رمز عبور"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#334155"/>
                    <TextBox x:Name="PasswordTextBox"
                             PasswordChar="●"
                             PlaceholderText="رمز عبور"
                             MinHeight="38"
                             FontSize="14"
                             Padding="12,8"
                             CornerRadius="6"
                             KeyDown="OnPasswordKeyDown"/>
                </StackPanel>

                <!-- پیام خطا — فقط متن رنگی، بدون پس‌زمینه -->
                <Border x:Name="MessageBorder"
                        Background="Transparent"
                        BorderBrush="#FECACA"
                        BorderThickness="0,0,0,2"
                        Padding="0,0,0,6"
                        IsVisible="False">
                    <TextBlock x:Name="MessageText"
                               Text=""
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#DC2626"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- دکمه ورود -->
                <Button x:Name="LoginButton"
                        Click="OnLoginClick"
                        Background="#1E40AF"
                        Foreground="White"
                        MinHeight="42"
                        CornerRadius="6"
                        FontSize="15" FontWeight="Bold"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconLogin}"
                                  Width="18" Height="18"
                                  Foreground="White"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="ورود به سیستم" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- نسخه -->
                <TextBlock x:Name="VersionText"
                           Text=""
                           FontSize="11"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>

</Window>
